# Public (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<supabase-publishable-key>
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only secrets (never prefix with NEXT_PUBLIC_, never commit real values)
# Supabase pooled connection string (transaction pooler, port 6543) used by the app at runtime
DATABASE_URL=
# Direct or session-pooler connection string (port 5432) used only by npm run db:migrate
DIRECT_URL=
# Needed only for Settings > Delete account (Supabase Auth admin API)
SUPABASE_SERVICE_ROLE_KEY=
